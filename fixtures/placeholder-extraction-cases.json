    "expectedNames": []
  },
  {
    "name": "unmatched_open_brace_left_literal",
    "template": "{x",
    "variables": { "x": "X" },
    "expectedRendered": "{x",
    "expectedNames": []
  },
  {
    "name": "unmatched_close_brace_left_literal",
    "template": "x}",
    "variables": { "x": "X" },
    "expectedRendered": "x}",
    "expectedNames": []
  },
  {
    "name": "valid_placeholder_followed_by_extra_close_brace_left_literal",
    "template": "{name}}",
    "variables": { "name": "Alice" },
    "expectedRendered": "{name}}",
    "expectedNames": []
  },
  {
    "name": "adjacent_placeholders_both_substituted",
    "template": "{a}{b}",
    "variables": { "a": "A", "b": "B" },
